cabal-version:      3.0
name:               video2ascii
version:            0.1.0.0
synopsis:           Convert videos to ASCII art frames for the text adventure
description:        Turns a short video clip into animated ASCII-art material
                    for the text-adventure engine (Phase F): either an ambient
                    loop (4-30 frames, evenly sampled, loop seam checked and
                    reported) or a cutscene clip file. ffmpeg/ffprobe are used
                    exclusively as external processes and only at build time;
                    the produced material is plain frames the engine already
                    understands (D6/D14/D15).
homepage:           https://github.com/Xethrocc/text-adventure
license:            MIT
license-file:       LICENSE
author:             Xethrocc
maintainer:         Xethrocc
copyright:          2026 Xethrocc
category:           Game
build-type:         Simple

library
  exposed-modules:     VideoToAscii
  hs-source-dirs:      src
  build-depends:       base >=4.12 && <5,
                       bytestring >=0.10,
                       process >=1.6
  default-language:    Haskell2010
  ghc-options:         -Wall -Werror=missing-fields

executable video2ascii
  main-is:             Main.hs
  hs-source-dirs:      app
  build-depends:       base >=4.12 && <5,
                       video2ascii,
                       bytestring >=0.10,
                       process >=1.6,
                       directory >=1.3,
                       filepath >=1.4
  default-language:    Haskell2010
  ghc-options:         -Wall -Werror=missing-fields

test-suite video2ascii-tests
  type:                exitcode-stdio-1.0
  main-is:             Tests.hs
  hs-source-dirs:      test
  build-depends:       base >=4.12 && <5,
                       video2ascii,
                       bytestring >=0.10,
                       process >=1.6,
                       directory >=1.3,
                       filepath >=1.4
  default-language:    Haskell2010
  ghc-options:         -Wall -Werror=missing-fields
