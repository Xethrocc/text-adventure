cabal-version:      3.0
name:               text-adventure-cli
version:            0.1.0.0
synopsis:           The main command-line entry point for the text adventure
description:        The classic Haskeline CLI frontend for the text-adventure
                    engine — the default way to play — plus the opt-in
                    @--tui@ flag (D20) that hands the game to the brick-based
                    terminal UI. Lives in its own package so the engine library
                    and its other tooling never depend on Brick, while one
                    executable can still offer both frontends.
homepage:           https://github.com/Xethrocc/text-adventure
license:            MIT
license-file:       LICENSE
author:             Xethrocc
maintainer:         Xethrocc
copyright:          2026 Xethrocc
category:           Game
build-type:         Simple

executable text-adventure
  main-is:             Main.hs
  hs-source-dirs:      app
  build-depends:       base >=4.12 && <5,
                       text-adventure,
                       text-adventure-tui
  default-language:    Haskell2010
  -- -threaded: --tui runs the Brick frontend with the animation ticker thread
  -- (H4b); the non-threaded runtime aborts with "RTS doesn't support multiple
  -- OS threads". Same flag as the text-adventure-tui executable.
  ghc-options:         -Wall -Werror=missing-fields -Werror=name-shadowing -Werror=incomplete-patterns -Werror=overlapping-patterns -threaded
