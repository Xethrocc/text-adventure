cabal-version:       3.0
name:                wasm-spike
version:             0.1.0.0
synopsis:            WASM feasibility spike (Plan 1.0) — NOT production code
description:         Builds the pure engine core with the GHC WASM backend and
                     runs applyLoopCommand inside a WASI runtime. First attempt
                     used IO stubs (stubs/, kept as fallback); the final variant
                     builds the unmodified production library from ../src.
license:             MIT
build-type:          Simple

library
  exposed-modules:   Types, Types.Core, Types.Cards, Types.Vehicles, Types.Combat,
                     Verbs, Game, GameLoop, Parser, Combat, Quests, Vehicles, Effects,
                     Cards, Completion, Ansi, Sample, Frontend, SaveLoad, World
  hs-source-dirs:    ../src
  build-depends:     base,
                     containers,
                     aeson,
                     bytestring,
                     text,
                     aeson-pretty,
                     time,
                     directory,
                     filepath,
                     process,
                     haskeline
  default-language:  Haskell2010
  ghc-options:       -Wall -Werror=missing-fields -Werror=incomplete-patterns

executable spike-main
  main-is:           Spike.hs
  hs-source-dirs:    .
  build-depends:     base, wasm-spike, containers
  default-language:  Haskell2010
  ghc-options:       -Wall