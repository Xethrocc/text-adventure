cabal-version:       3.0
name:                text-adventure
version:             0.10.0.0
synopsis:            A simple text-based adventure game engine written in Haskell
description:         A simple text-based adventure game engine written in Haskell. This package provides a flexible framework for creating interactive text adventures with rooms, items, NPCs, and player commands.
homepage:            https://github.com/Xethrocc/text-adventure
license:             MIT
license-file:        LICENSE
author:              Xethrocc
maintainer:          Xethrocc
copyright:           2026 Xethrocc
category:            Game
extra-source-files:
    README.md
    CHANGELOG.md
    docs/adventure-schema.md
    docs/genres.md
    docs/modules.md
    docs/thefog-playthrough.md
    scripts/ci.sh
    ci/e2e/*.in
    ci/e2e/*.expect

library
  exposed-modules:     Types, Verbs, Game, GameLoop, Frontend, Completion, Combat, Parser, SaveLoad, World, Sample, Validate, Ansi
  hs-source-dirs:      src
  build-depends:       base >=4.12 && <5,
                       containers >=0.6 && <0.8,
                       aeson >=2.0 && <3,
                       aeson-pretty >=0.8 && <1,
                       bytestring >=0.10 && <1,
                       text >=1.2 && <3,
                       haskeline >=0.8 && <1,
                       time >=1.9 && <2,
                       directory >=1.3 && <2,
                       filepath >=1.4 && <2
  default-language:    Haskell2010
  ghc-options:         -Wall -Werror=missing-fields -Werror=name-shadowing -Werror=incomplete-patterns -Werror=overlapping-patterns

test-suite text-adventure-tests
  type:                exitcode-stdio-1.0
  main-is:             Tests.hs
  hs-source-dirs:      test
  build-depends:       base >=4.12 && <5,
                       text-adventure,
                       aeson >=2.0 && <3,
                       bytestring >=0.10 && <1,
                       containers >=0.6 && <0.8,
                       haskeline >=0.8 && <1,
                       directory >=1.3 && <2
  default-language:    Haskell2010
  ghc-options:         -Wall -Werror=missing-fields -Werror=name-shadowing -Werror=incomplete-patterns -Werror=overlapping-patterns
