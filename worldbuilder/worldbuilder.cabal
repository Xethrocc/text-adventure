cabal-version:      3.0
name:               worldbuilder
version:            0.5.0.0
synopsis:           Authoring toolchain for the text-adventure engine
description:        Turns authored YAML content into the GameWorld and SaveState
                    JSON files that the text-adventure engine loads.
homepage:           https://github.com/Xethrocc/text-adventure
license:            MIT
license-file:       ../LICENSE
author:             Xethrocc
maintainer:         Xethrocc
copyright:          2026 Xethrocc
category:           Game
build-type:         Simple

library
  exposed-modules:     Worldbuilder.Types
                       Worldbuilder.Compile
                       Worldbuilder.CLI
  hs-source-dirs:      src
  build-depends:       base >=4.12 && <5,
                       text-adventure,
                       aeson >=2.0 && <3,
                       bytestring >=0.10 && <1,
                       containers >=0.6 && <0.8,
                       filepath >=1.4 && <2,
                       directory >=1.3 && <2
  default-language:    Haskell2010
  ghc-options:         -Wall

executable worldbuilder
  main-is:             Main.hs
  hs-source-dirs:      app
  build-depends:       base >=4.12 && <5,
                       worldbuilder
  default-language:    Haskell2010
  ghc-options:         -Wall